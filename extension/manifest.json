{
  "manifest_version": 3,
  "name": "Visual Activity Monitor",
  "version": "1.0.0",
  "description": "Chrome Extension for automated browser activity tracking and screenshot capture.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Visual Activity Monitor"
  }
}
